# Copy this file to .env and fill in your values locally. Never commit real tokens.

# Slack bot token (xoxb-...): app settings -> OAuth & Permissions -> Bot User OAuth Token.
# Required in all modes. Authorizes replies and attachment downloads.
SLACK_BOT_TOKEN=

# Slack app-level token (xapp-...): Basic Information -> App-Level Tokens.
# Required in all modes. Generate with connections:write and enable Socket Mode.
SLACK_APP_TOKEN=

# Allowed workspace ID (T...): the segment after /client/ in your Slack web URL.
# Required in all modes; must match the workspace where the bot is installed.
SLACK_TEAM_ID=

# Anthropic Console API key: required when CLAUDE_BACKEND=api and ECHO_MODE=false.
# Create at https://platform.claude.com/ . API billing is separate from subscriptions.
# Leave blank for the Claude Code backend; subscription OAuth tokens do not work here.
ANTHROPIC_API_KEY=

# API backend: required model ID available to your Anthropic API account.
# Code backend: optional Claude Code model ID or alias (e.g. sonnet); defaults to sonnet.
# Ignored in echo mode.
ANTHROPIC_MODEL=

# Choose api for direct Anthropic API requests, or code for the installed Claude Code CLI.
# Code mode requires a CLI version supporting --safe-mode (verified with 2.1.236).
CLAUDE_BACKEND=api

# Required when CLAUDE_BACKEND=code and ECHO_MODE=false.
# Generate locally with `claude setup-token` using your Claude subscription.
# Subscription limits apply; Anthropic restricts serving other users through one Max account.
# Leave blank for the API backend. This token is passed only to the Claude Code process.
CLAUDE_CODE_OAUTH_TOKEN=

# Set exactly true to check Slack connectivity by echoing messages without calling Claude.
# Echo mode needs only the three Slack settings above; AI credentials/model are ignored.
# Set false for Claude replies. Restart the bot after changing any .env setting.
ECHO_MODE=false
